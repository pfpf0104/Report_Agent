# app/core/config.py의 Settings가 REPORT_AGENT_ 접두사로 읽는 환경변수.
# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 .gitignore에 의해 커밋되지 않는다.

REPORT_AGENT_DATABASE_URL=postgresql+psycopg2://report_agent:report_agent@localhost:5432/report_agent

# Cloudflare Tunnel로 외부에 노출하기 전 반드시 변경. 기본값(changeme)으로 두면
# 앱 기동 시 경고 로그가 출력된다.
REPORT_AGENT_API_KEY=changeme

# Supabase 서빙 캐시 동기화(app/sync/supabase_sync.py)용. 둘 다 비워두면 동기화가
# 조용히 스킵되고 로컬 전용으로 동작한다 — 무료 티어 프로젝트를 쓸 때만 채운다.
# URL: Supabase 대시보드 Project Settings > API > Project URL
# SERVICE_KEY: 같은 화면의 service_role 키 (절대 커밋하지 말 것 — RLS를 우회하는 키)
REPORT_AGENT_SUPABASE_URL=
REPORT_AGENT_SUPABASE_SERVICE_KEY=

# Cloudflare R2(PDF 저장, app/sync/r2_sync.py)용. 전부 비워두면 스킵되고 PDF는
# reports_router의 로컬 스트리밍으로만 제공된다. R2는 Cloudflare 대시보드에서
# 계정당 한 번 수동으로 활성화해야 한다("Enable R2" 버튼) — API로는 불가능.
# 활성화 후: R2 > Manage API tokens에서 access key 발급, 버킷 생성 후 아래를 채운다.
REPORT_AGENT_R2_ACCOUNT_ID=
REPORT_AGENT_R2_ACCESS_KEY_ID=
REPORT_AGENT_R2_SECRET_ACCESS_KEY=
REPORT_AGENT_R2_BUCKET_NAME=
REPORT_AGENT_R2_PUBLIC_BASE_URL=
